# Postgres (es. Neon o Supabase, piano gratuito)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Stripe (Dashboard > Sviluppatori > Chiavi API). Usa le chiavi di test finché non lanci.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL pubblico del sito, senza slash finale
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segreti per le chiamate di servizio (stringhe lunghe e casuali)
CRON_SECRET=cambia-questo-valore
ADMIN_TOKEN=cambia-anche-questo

# Dati del titolare, mostrati in termini e privacy
NEXT_PUBLIC_OWNER_NAME=Nome Cognome
NEXT_PUBLIC_OWNER_EMAIL=contatti@esempio.it
